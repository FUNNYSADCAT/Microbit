// ===== ปรับค่าตรงนี้ =====
let DIR = -1          // รถถอยหลังก็ใช้ -1, ถ้าไปหน้าถูกแล้วเปลี่ยนเป็น 1
let BASE = 170
let MIN_SPD = 70
let KP = 1.6
let KD = 5
let LOST_LIMIT = 5    // ไม่เจอเส้นกี่รอบติดกันถึงจะหยุด (กันค่าเพี้ยนชั่วขณะ)

// ===== ตัวแปรระบบ =====
let raw = 0
let error = 0
let lastError = 0
let deriv = 0
let corr = 0
let spd = 0
let lostCount = 0

function drive(l: number, r: number) {
    zoombit.setMotorsSpeed(
        Math.round(Math.constrain(l, -255, 255)) * DIR,
        Math.round(Math.constrain(r, -255, 255)) * DIR
    )
}

zoombit.setHeadlight(HeadlightChannel.All, zoombit.digitalStatePicker(DigitalIoState.On))

basic.forever(function () {
    raw = pins.analogReadPin(AnalogPin.P1)

    if (raw < 81) {
        // ไม่เจอเส้น -> หยุด
        lostCount += 1
        if (lostCount >= LOST_LIMIT) {
            zoombit.brake()
        }
    } else if (raw > 941) {
        // ดำทุกช่อง (สี่แยก) -> พุ่งตรง
        lostCount = 0
        drive(BASE, BASE)
    } else {
        lostCount = 0
        error = Math.constrain((raw - 512) / 4, -100, 100)
        deriv = error - lastError
        corr = KP * error + KD * deriv
        spd = Math.max(MIN_SPD, BASE - Math.abs(error))
        drive(spd + corr, spd - corr)
        lastError = error
    }
})
