// ===== ปรับค่าตรงนี้ =====
let DIR = -1
let BASE = 170
let MIN_SPD = 60
let KP = 1.6
let KD = 5
let DEADBAND = 25         // ครอบคลุมเซนเซอร์ข้างๆ (ยังสะบัดอยู่ให้เพิ่มเป็น 30)
let SOFT_ZONE = 50        // ต่ำกว่านี้ = โหมดวิ่งตรงนุ่มๆ, เกินนี้ = โหมดโค้งเต็มแรง
let STRAIGHT_SMOOTH = 0.4 // เฉลี่ยค่าตอนวิ่งตรง (ยิ่งน้อยยิ่งนุ่ม)
let KD_STRAIGHT = 1       // KD ตอนวิ่งตรง
let BRAKE_SLOW = 1.5
let BIG_KP = 0.8
let LOST_LIMIT = 40
let TURN_IN = 190
let TURN_OUT = -70

// ===== ตัวแปรระบบ =====
let raw = 0
let e = 0
let error = 0
let eF = 0
let lastError = 0
let lastDir = 1
let deriv = 0
let gain = 0
let corr = 0
let spd = 0
let lostCount = 0

function drive(l: number, r: number) {
    zoombit.setMotorsSpeed(
        Math.round(Math.constrain(l, -255, 255)) * DIR,
        Math.round(Math.constrain(r, -255, 255)) * DIR
    )
}

zoombit.setHeadlight(HeadlightChannel.All, zoombit.digitalStatePicker(DigitalIoState.On))

basic.forever(function () {
    raw = pins.analogReadPin(AnalogPin.P1)

    if (raw < 81) {
        lostCount += 1
        if (lostCount >= LOST_LIMIT) {
            zoombit.brake()
        } else if (lastDir < 0) {
            drive(TURN_OUT, TURN_IN)
        } else {
            drive(TURN_IN, TURN_OUT)
        }
    } else if (raw > 941) {
        lostCount = 0
        drive(BASE, BASE)
    } else {
        lostCount = 0
        e = Math.constrain((raw - 512) / 4, -100, 100)

        // จำทิศล่าสุดไว้ใช้ตอนหลุดเส้น
        if (Math.abs(e) >= 10) {
            lastDir = e > 0 ? 1 : -1
        }

        if (Math.abs(e) < SOFT_ZONE) {
            // ===== โหมดวิ่งตรง: นุ่ม ไม่สะบัด =====
            if (Math.abs(e) < DEADBAND) {
                error = 0
            } else {
                // ไล่แรงขึ้นต่อเนื่อง ไม่กระโดด
                error = (Math.abs(e) - DEADBAND) * SOFT_ZONE / (SOFT_ZONE - DEADBAND)
                if (e < 0) error = -error
            }
            eF = eF * (1 - STRAIGHT_SMOOTH) + error * STRAIGHT_SMOOTH
            error = eF
            gain = 0.6 + Math.abs(error) / SOFT_ZONE * 0.4
            corr = (KP * error + KD_STRAIGHT * (error - lastError)) * gain
        } else {
            // ===== โหมดโค้ง: แรงเต็ม เหมือนเดิม =====
            error = e
            eF = e
            deriv = error - lastError
            corr = KP * error + KD * deriv
            corr += (error > 0 ? 1 : -1) * (Math.abs(error) - 50) * BIG_KP * (Math.abs(error) > 50 ? 1 : 0)
        }

        spd = Math.max(MIN_SPD, BASE - Math.abs(error) * BRAKE_SLOW)
        drive(spd + corr, spd - corr)
        lastError = error
    }
})
