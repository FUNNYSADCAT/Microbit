// ===== ปรับค่าตรงนี้ =====
let DIR = -1
let BASE = 255            // ใส่ได้ถึง 255
let MIN_SPD = 70          // ความเร็วต่ำสุดตอนโค้งหนักสุด
let KP = 1.6
let KD = 3
let DEADBAND = 30
let SOFT_ZONE = 60        // ต้องน้อยกว่า 100 และมากกว่า DEADBAND
let STRAIGHT_SMOOTH = 0.8
let KD_STRAIGHT = 1
let CURVE_FULL = 70       // เบี่ยงเท่านี้ = ชะลอถึง MIN_SPD
let BIG_KP = 1.0          // แรงเสริมตอนโค้งหนัก
let LOST_LIMIT = 40
let TURN_IN = 230
let TURN_OUT = -90

// ===== ตัวแปรระบบ =====
let raw = 0
let e = 0
let error = 0
let eF = 0
let lastError = 0
let lastDir = 1
let corr = 0
let spd = 0
let gain = 0
let l = 0
let r = 0
let lostCount = 0

function drive(left: number, right: number) {
    zoombit.setMotorsSpeed(
        Math.round(Math.constrain(left, -255, 255)) * DIR,
        Math.round(Math.constrain(right, -255, 255)) * DIR
    )
}

zoombit.setHeadlight(HeadlightChannel.All, zoombit.digitalStatePicker(DigitalIoState.On))

basic.forever(function () {
    raw = pins.analogReadPin(AnalogPin.P1)

    if (raw < 81) {
        lostCount += 1
        if (lostCount >= LOST_LIMIT) {
            zoombit.brake()
        } else if (lastDir < 0) {
            drive(TURN_OUT, TURN_IN)
        } else {
            drive(TURN_IN, TURN_OUT)
        }
    } else if (raw > 941) {
        lostCount = 0
        drive(BASE, BASE)
    } else {
        lostCount = 0
        e = Math.constrain((raw - 512) / 4, -100, 100)

        if (Math.abs(e) >= 10) {
            lastDir = e > 0 ? 1 : -1
        }

        if (Math.abs(e) < SOFT_ZONE) {
            // ===== โหมดวิ่งตรง: นุ่ม =====
            if (Math.abs(e) < DEADBAND) {
                error = 0
            } else {
                error = (Math.abs(e) - DEADBAND) * SOFT_ZONE / (SOFT_ZONE - DEADBAND)
                if (e < 0) error = -error
            }
            eF = eF * (1 - STRAIGHT_SMOOTH) + error * STRAIGHT_SMOOTH
            error = eF
            gain = 0.6 + Math.abs(error) / SOFT_ZONE * 0.4
            corr = (KP * error + KD_STRAIGHT * (error - lastError)) * gain
        } else {
            // ===== โหมดโค้ง: แรงเต็ม =====
            error = e
            eF = e
            corr = KP * error + KD * (error - lastError)
            corr += (error > 0 ? 1 : -1) * (Math.abs(error) - SOFT_ZONE) * BIG_KP
        }

        // ชะลอตามความหักของโค้ง (สเกลตาม BASE)
        spd = BASE - (BASE - MIN_SPD) * Math.min(1, Math.abs(error) / CURVE_FULL)

        l = spd + corr
        r = spd - corr
        // ล้อนอกเกิน 255 -> หักส่วนเกินจากล้อใน เพื่อรักษาส่วนต่าง
        if (l > 255) {
            r -= (l - 255)
            l = 255
        }
        if (r > 255) {
            l -= (r - 255)
            r = 255
        }
        drive(l, r)
        lastError = error
    }
})
