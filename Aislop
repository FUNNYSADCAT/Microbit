// ===== ปรับค่าตรงนี้ =====
let DIR = -1
let BASE = 255
let MIN_SPD = 60
let KP = 1.6
let KD = 3
let DEADBAND = 30
let SOFT_ZONE = 60
let STRAIGHT_SMOOTH = 0.8
let KD_STRAIGHT = 1
let CURVE_FULL = 60       // เบี่ยงเท่านี้ = ชะลอถึง MIN_SPD
let BIG_KP = 1.2
let SHARP_E = 85          // เบี่ยงเกินนี้ = เซนเซอร์นอกสุด -> เตะแรงเลี้ยวเพิ่ม
let SHARP_KICK = 90       // แรงเตะ (เพิ่มถ้าเลี้ยวไม่ทัน)
let CURVE_DRAG = 4        // ยิ่งอยู่ในโค้งหนักนาน ยิ่งชะลอ (ลดความเร็วต่อรอบ)
let CURVE_MAX = 30        // เพดานสะสม
let LOST_LIMIT = 40
let TURN_IN = 200         // ล้อนอกตอนหลุดเส้น
let TURN_OUT = -160       // ล้อในตอนหลุดเส้น (ถอยแรงขึ้น)

// ===== ตัวแปรระบบ =====
let raw = 0
let e = 0
let error = 0
let eF = 0
let lastError = 0
let lastDir = 1
let corr = 0
let spd = 0
let gain = 0
let l = 0
let r = 0
let lostCount = 0
let curveLoad = 0

function drive(left: number, right: number) {
    zoombit.setMotorsSpeed(
        Math.round(Math.constrain(left, -255, 255)) * DIR,
        Math.round(Math.constrain(right, -255, 255)) * DIR
    )
}

zoombit.setHeadlight(HeadlightChannel.All, zoombit.digitalStatePicker(DigitalIoState.On))

basic.forever(function () {
    raw = pins.analogReadPin(AnalogPin.P1)

    if (raw < 81) {
        // หลุดเส้น: หมุนตัวแรงไปทางที่เห็นเส้นล่าสุด
        lostCount += 1
        if (lostCount >= LOST_LIMIT) {
            zoombit.brake()
        } else if (lastDir < 0) {
            drive(TURN_OUT, TURN_IN)
        } else {
            drive(TURN_IN, TURN_OUT)
        }
    } else if (raw > 941) {
        lostCount = 0
        drive(BASE, BASE)
    } else {
        lostCount = 0
        e = Math.constrain((raw - 512) / 4, -100, 100)

        if (Math.abs(e) >= 10) {
            lastDir = e > 0 ? 1 : -1
        }

        // สะสมความหนักของโค้ง
        if (Math.abs(e) >= 60) {
            curveLoad = Math.min(CURVE_MAX, curveLoad + 1)
        } else {
            curveLoad = Math.max(0, curveLoad - 1)
        }

        if (Math.abs(e) < SOFT_ZONE) {
            // ===== โหมดวิ่งตรง: นุ่ม =====
            if (Math.abs(e) < DEADBAND) {
                error = 0
            } else {
                error = (Math.abs(e) - DEADBAND) * SOFT_ZONE / (SOFT_ZONE - DEADBAND)
                if (e < 0) error = -error
            }
            eF = eF * (1 - STRAIGHT_SMOOTH) + error * STRAIGHT_SMOOTH
            error = eF
            gain = 0.6 + Math.abs(error) / SOFT_ZONE * 0.4
            corr = (KP * error + KD_STRAIGHT * (error - lastError)) * gain
        } else {
            // ===== โหมดโค้ง: แรงเต็ม =====
            error = e
            eF = e
            corr = KP * error + KD * (error - lastError)
            corr += (error > 0 ? 1 : -1) * (Math.abs(error) - SOFT_ZONE) * BIG_KP
            // เซนเซอร์นอกสุด: เตะแรงเลี้ยวเพิ่ม
            if (Math.abs(error) >= SHARP_E) {
                corr += (error > 0 ? 1 : -1) * SHARP_KICK
            }
        }

        // ชะลอตามความหักของโค้ง + ยิ่งอยู่ในโค้งนานยิ่งช้า
        spd = BASE - (BASE - MIN_SPD) * Math.min(1, Math.abs(error) / CURVE_FULL)
        spd = Math.max(MIN_SPD, spd - curveLoad * CURVE_DRAG)

        l = spd + corr
        r = spd - corr
        if (l > 255) {
            r -= (l - 255)
            l = 255
        }
        if (r > 255) {
            l -= (r - 255)
            r = 255
        }
        drive(l, r)
        lastError = error
    }
})
