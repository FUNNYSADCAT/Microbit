// ===== ปรับค่าตรงนี้ =====
let DIR = -1
let BASE = 170
let MIN_SPD = 60
let KP = 1.6
let KD = 5
let DEADBAND = 10
let D_SMOOTH = 0.1    // ใช้กรองเฉพาะตอนวิ่งตรง
let SOFT_ZONE = 25    // เบี่ยงเกินนี้ = แรงเต็ม + derivative ไม่กรอง
let BRAKE_SLOW = 1.5  // ชะลอตอนเข้าโค้ง (ยิ่งมากยิ่งช้า)
let BIG_KP = 0.8      // แรงเสริมตอนเบี่ยงเกิน 50
let LOST_LIMIT = 40   // หลุดเส้นกี่รอบถึงหยุด
let TURN_IN = 190     // ล้อนอกตอนหลุดเส้น
let TURN_OUT = -70    // ล้อในตอนหลุดเส้น

// ===== ตัวแปรระบบ =====
let raw = 0
let error = 0
let lastError = 0
let deriv = 0
let dFilt = 0
let gain = 0
let corr = 0
let spd = 0
let lostCount = 0

function drive(l: number, r: number) {
    zoombit.setMotorsSpeed(
        Math.round(Math.constrain(l, -255, 255)) * DIR,
        Math.round(Math.constrain(r, -255, 255)) * DIR
    )
}

zoombit.setHeadlight(HeadlightChannel.All, zoombit.digitalStatePicker(DigitalIoState.On))

basic.forever(function () {
    raw = pins.analogReadPin(AnalogPin.P1)

    if (raw < 81) {
        // หลุดเส้น: เลี้ยวตามทางเดิมก่อน ถ้านานเกินค่อยหยุด
        lostCount += 1
        if (lostCount >= LOST_LIMIT) {
            zoombit.brake()
        } else if (lastError < 0) {
            drive(TURN_OUT, TURN_IN)
        } else {
            drive(TURN_IN, TURN_OUT)
        }
    } else if (raw > 941) {
        lostCount = 0
        drive(BASE, BASE)
    } else {
        lostCount = 0
        error = Math.constrain((raw - 512) / 4, -100, 100)

        if (Math.abs(error) < DEADBAND) {
            error = 0
        }

        deriv = error - lastError
        if (Math.abs(error) < SOFT_ZONE) {
            // วิ่งตรง: กรองให้นิ่ง
            dFilt = dFilt * (1 - D_SMOOTH) + deriv * D_SMOOTH
            gain = 0.35 + Math.abs(error) / SOFT_ZONE * 0.65
        } else {
            // โค้ง: ใช้ค่าจริง แรงเต็ม
            dFilt = deriv
            gain = 1
        }

        corr = (KP * error + KD * dFilt) * gain
        // เบี่ยงมากกว่า 50 เสริมแรงอีก
        if (Math.abs(error) > 50) {
            corr += (error > 0 ? 1 : -1) * (Math.abs(error) - 50) * BIG_KP
        }

        spd = Math.max(MIN_SPD, BASE - Math.abs(error) * BRAKE_SLOW)
        drive(spd + corr, spd - corr)
        lastError = error
    }
})
